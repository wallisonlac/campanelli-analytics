---
import BaseLayout from "../../layouts/BaseLayout.astro";
import content from "../../content/en.json";
const { about, footer, nav, meta } = content;
---
<BaseLayout
  lang="en" htmlLang={content.htmlLang}
  title={meta.about.title} description={meta.about.description}
  path="/en/about/" altPath="/pt/sobre/"
  nav={nav} footer={footer}
  privacyPath="/en/privacy/" termsPath="/en/terms/"
  linkedin={about.linkedin} github={about.github}
>
  <section class="section section--dark">
    <div class="container">
      <h1>{about.title}</h1>
      <p>{about.story}</p>
      <p>{about.storyExtra}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="leadership">
        <div class="leadership__photo">
          <img
            src={about.photoPlaceholder}
            alt="Wallison Campanelli — Founder and Data Engineering Consultant"
            loading="lazy"
          />
        </div>

        <div>
          <h2>{about.founderTitle}</h2>
          {about.founderBio.map((p) => <p>{p}</p>)}
          <p>
            <a href={about.linkedin} target="_blank" rel="noopener noreferrer">{about.linkedinLabel}</a> ·
            <a href={about.github} target="_blank" rel="noopener noreferrer">{about.githubLabel}</a>
          </p>
        </div>
      </div>

      <div class="company-logo">
        <img
          src={about.logoPlaceholder}
          alt="Campanelli Analytics"
          loading="lazy"
        />
      </div>

      <p class="disclaimer-box">{about.founderNote}</p>
    </div>
  </section>
</BaseLayout>
