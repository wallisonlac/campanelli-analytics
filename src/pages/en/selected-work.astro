---
import BaseLayout from '../../layouts/BaseLayout.astro';

const deliveryAreas = [
  { title: 'Data Platform Foundations', challenge: 'Teams need a dependable foundation for collecting, organizing and governing data from multiple operational sources.', scope: 'Assess source systems, define a practical target architecture, establish ingestion patterns, create data layers, implement orchestration and document ownership.', capabilities: 'Azure, Databricks, Microsoft Fabric, Snowflake, PySpark, SQL, data modeling, orchestration and data quality practices.', outcomes: 'A clearer data architecture, repeatable ingestion patterns, better reliability and a foundation that supports analytics and future automation.' },
  { title: 'Pipeline Modernization', challenge: 'Legacy, manual or fragile ETL processes make reporting slow, create operational risk and limit the ability to scale.', scope: 'Map current workflows, prioritize high-value pipelines, refactor transformations, introduce orchestration, validation and monitoring, and improve maintainability.', capabilities: 'ETL/ELT, Python, SQL, PySpark, Airflow, Databricks, Azure data services, transformation practices and testing.', outcomes: 'More repeatable pipeline delivery, fewer manual handoffs, improved observability and faster access to trusted datasets.' },
  { title: 'Lakehouse and Cloud Analytics', challenge: 'Organizations want cloud analytics capabilities but need a practical path from disconnected sources to governed, usable data products.', scope: 'Design lakehouse layers, establish ingestion and transformation patterns, create curated datasets and prepare analytics-ready access.', capabilities: 'Databricks, Microsoft Fabric, Azure, Snowflake, Delta Lake patterns, Spark, SQL, semantic modeling and Power BI integration.', outcomes: 'A scalable analytics foundation, improved consistency across reporting and a more practical route to self-service data use.' },
  { title: 'Analytics and BI Enablement', challenge: 'Business teams spend too much time reconciling spreadsheets, debating metric definitions or waiting for data preparation.', scope: 'Define business metrics, model trusted datasets, create semantic layers and enable dashboards or reporting workflows.', capabilities: 'SQL, Power BI, dimensional modeling, analytics engineering, data quality checks, governance patterns and stakeholder alignment.', outcomes: 'More consistent metrics, reduced reporting friction and decision-ready datasets that business teams can trust.' },
  { title: 'Data Automation and AI-Enabled Workflows', challenge: 'Operational teams need to reduce repetitive work while preparing reliable data foundations for practical AI use cases.', scope: 'Identify manual bottlenecks, automate data movement and quality controls, create structured knowledge or data layers and define pragmatic AI-enabled workflows.', capabilities: 'Python, APIs, data orchestration, automation design, data quality, workflow integration and AI-ready data preparation.', outcomes: 'Less manual operational effort, more traceable workflows and a better foundation for responsible AI experimentation.' }
];
---

<BaseLayout title="Selected Data Engineering Capabilities | Campanelli Analytics" description="Explore delivery areas across data platforms, ETL/ELT, lakehouse, analytics, automation and AI-enabled workflows." lang="en">
  <main>
    <section class="page-hero"><div class="container"><p class="eyebrow">SELECTED CAPABILITIES</p><h1>Practical data engineering delivery for complex operational challenges.</h1><p class="lead">Examples of delivery areas based on hands-on experience across data engineering, cloud platforms, analytics and automation. Specific scope, architecture and measurable outcomes are defined collaboratively for each engagement.</p></div></section>
    <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">HOW WE DELIVER</p><h2>Delivery areas</h2><p>The goal is not to prescribe a generic solution. Each engagement begins with the business context, technical constraints and the outcome your team needs to achieve.</p></div><div class="service-grid">{deliveryAreas.map((area) => (<article class="service-card"><h3>{area.title}</h3><p><strong>Challenge area:</strong> {area.challenge}</p><p><strong>Typical delivery scope:</strong> {area.scope}</p><p><strong>Selected capabilities:</strong> {area.capabilities}</p><p><strong>Typical project outcomes:</strong> {area.outcomes}</p></article>))}</div></div></section>
    <section class="section section-alt"><div class="container narrow"><div class="section-heading"><p class="eyebrow">MEASURABLE IMPACT</p><h2>Results are documented when the evidence is available.</h2><p>Where client approval and verified data are available, engagements can be documented with relevant measures such as delivery time, manual steps removed, pipeline reliability, reporting availability, adoption and operational effort saved.</p></div></div></section>
    <section class="section cta-section"><div class="container narrow"><p class="eyebrow">START A CONVERSATION</p><h2>Have a data initiative that needs dependable delivery?</h2><p>Book a short discovery call to discuss your current stack, delivery objective, timeline and constraints.</p><div class="hero-actions"><a class="button button-primary" href="https://calendly.com/wallisoncampanelli-eng/30min" target="_blank" rel="noopener noreferrer">Book a 30-minute discovery call</a><a class="button button-secondary" href="/en/contact/">Discuss your project</a></div></div></section>
  </main>
</BaseLayout>
