---
import BaseLayout from "../../layouts/BaseLayout.astro";
import content from "../../content/pt.json";
const { globalDelivery, leadership, footer, nav, meta } = content;
---
<BaseLayout
  lang="pt" htmlLang={content.htmlLang}
  title={meta.globalDelivery.title} description={meta.globalDelivery.description}
  path="/pt/entrega-internacional/" altPath="/en/global-delivery/"
  nav={nav} footer={footer}
  privacyPath="/pt/privacidade/" termsPath="/pt/termos/"
  linkedin={leadership.linkedin} github={leadership.github}
>
  <section class="section section--dark">
    <div class="container">
      <h1>{globalDelivery.title}</h1>
      <p>{globalDelivery.subtitle}</p>
      <p>{globalDelivery.text}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>{globalDelivery.modelsTitle}</h2>
      <ul class="list-plain">
        {globalDelivery.models.map((m) => <li>{m}</li>)}
      </ul>
      <div class="disclaimer-box">{globalDelivery.disclaimer}</div>
    </div>
  </section>
</BaseLayout>
