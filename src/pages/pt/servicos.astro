---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import content from "../../content/pt.json";
const { services, leadership, footer, nav, meta } = content;
---
<BaseLayout
  lang="pt" htmlLang={content.htmlLang}
  title={meta.services.title} description={meta.services.description}
  path="/pt/servicos/" altPath="/en/services/"
  nav={nav} footer={footer}
  privacyPath="/pt/privacidade/" termsPath="/pt/termos/"
  linkedin={leadership.linkedin} github={leadership.github}
>
  <section class="section section--dark">
    <div class="container">
      <h1>{services.title}</h1>
      <p>{services.intro}</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid--2">
      {services.items.map((s) => (
        <ServiceCard title={s.title} description={s.description} bullets={s.bullets} disclaimer={s.disclaimer} />
      ))}
    </div>
  </section>
</BaseLayout>
