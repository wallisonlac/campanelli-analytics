---
import BaseLayout from '../../layouts/BaseLayout.astro';
import content from '../../content/pt.json';

const areasDeEntrega = [
  { title: 'Fundações de Plataformas de Dados', desafio: 'Equipas precisam de uma base confiável para recolher, organizar e governar dados vindos de múltiplas fontes operacionais.', escopo: 'Avaliar sistemas de origem, definir uma arquitetura-alvo prática, estabelecer padrões de ingestão, criar camadas de dados, implementar orquestração e documentar responsabilidades.', capacidades: 'Azure, Databricks, Microsoft Fabric, Snowflake, PySpark, SQL, modelagem de dados, orquestração e práticas de qualidade de dados.', resultados: 'Uma arquitetura de dados mais clara, padrões de ingestão repetíveis, maior confiabilidade e uma base que suporta analytics e automação futura.' },
  { title: 'Modernização de Pipelines', desafio: 'Processos ETL legados, manuais ou frágeis tornam o reporting lento, criam risco operacional e limitam a capacidade de escalar.', escopo: 'Mapear workflows atuais, priorizar pipelines de maior valor, refatorar transformações, introduzir orquestração, validação e monitorização e melhorar a manutenção.', capacidades: 'ETL/ELT, Python, SQL, PySpark, Airflow, Databricks, serviços de dados Azure, práticas de transformação e testes.', resultados: 'Entrega de pipelines mais repetível, menos transferências manuais, melhor observabilidade e acesso mais rápido a datasets confiáveis.' },
  { title: 'Lakehouse e Analytics em Cloud', desafio: 'Organizações querem capacidades analíticas em cloud, mas precisam de um caminho prático entre fontes desconectadas e produtos de dados governados e utilizáveis.', escopo: 'Desenhar camadas lakehouse, estabelecer padrões de ingestão e transformação, criar datasets curados e preparar acesso pronto para analytics.', capacidades: 'Databricks, Microsoft Fabric, Azure, Snowflake, padrões Delta Lake, Spark, SQL, modelagem semântica e integração Power BI.', resultados: 'Uma fundação analítica escalável, maior consistência no reporting e um caminho mais prático para uso self-service de dados.' },
  { title: 'Analytics e BI', desafio: 'Equipas de negócio gastam demasiado tempo conciliando folhas de cálculo, discutindo definições de métricas ou esperando pela preparação de dados.', escopo: 'Definir métricas de negócio, modelar datasets confiáveis, criar camadas semânticas e viabilizar dashboards ou workflows de reporting.', capacidades: 'SQL, Power BI, modelagem dimensional, analytics engineering, verificações de qualidade de dados, padrões de governance e alinhamento com stakeholders.', resultados: 'Métricas mais consistentes, menor fricção no reporting e datasets prontos para decisão em que as equipas podem confiar.' },
  { title: 'Automação de Dados e Workflows com IA', desafio: 'Equipas operacionais precisam reduzir trabalho repetitivo enquanto preparam fundações de dados confiáveis para casos de uso práticos com IA.', escopo: 'Identificar gargalos manuais, automatizar movimentação de dados e controlos de qualidade, criar camadas de dados ou conhecimento estruturadas e definir workflows pragmáticos com IA.', capacidades: 'Python, APIs, orquestração de dados, desenho de automação, qualidade de dados, integração de workflows e preparação de dados para IA.', resultados: 'Menos esforço operacional manual, workflows mais rastreáveis e uma base melhor para experimentação responsável com IA.' }
];
---

<BaseLayout content={content} title="Capacidades em Engenharia de Dados | Campanelli Analytics" description="Conheça áreas de entrega em plataformas de dados, ETL/ELT, lakehouse, analytics, automação e workflows de dados com IA." lang="pt">
  <main>
    <section class="page-hero"><div class="container"><p class="eyebrow">CAPACIDADES SELECIONADAS</p><h1>Entrega prática de Data Engineering para desafios operacionais complexos.</h1><p class="lead">Exemplos de áreas de entrega baseados em experiência prática em engenharia de dados, plataformas cloud, analytics e automação. O escopo específico, a arquitetura e os resultados mensuráveis são definidos em conjunto para cada projeto.</p></div></section>
    <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">COMO ENTREGAMOS</p><h2>Áreas de entrega</h2><p>O objetivo não é prescrever uma solução genérica. Cada projeto começa pelo contexto de negócio, pelas restrições técnicas e pelo resultado que a sua equipa precisa alcançar.</p></div><div class="service-grid">{areasDeEntrega.map((area) => (<article class="service-card"><h3>{area.title}</h3><p><strong>Área do desafio:</strong> {area.desafio}</p><p><strong>Escopo típico de entrega:</strong> {area.escopo}</p><p><strong>Capacidades selecionadas:</strong> {area.capacidades}</p><p><strong>Resultados típicos do projeto:</strong> {area.resultados}</p></article>))}</div></div></section>
    <section class="section section-alt"><div class="container narrow"><div class="section-heading"><p class="eyebrow">IMPACTO MENSURÁVEL</p><h2>Os resultados são documentados quando existem evidências disponíveis.</h2><p>Quando houver aprovação do cliente e dados verificados, os projetos podem ser documentados com medidas relevantes, como tempo de entrega, etapas manuais eliminadas, confiabilidade de pipelines, disponibilidade de reporting, adoção e esforço operacional poupado.</p></div></div></section>
    <section class="section cta-section"><div class="container narrow"><p class="eyebrow">INICIE UMA CONVERSA</p><h2>Tem uma iniciativa de dados que precisa de entrega confiável?</h2><p>Agende uma conversa curta para falar sobre a stack atual, objetivo de entrega, prazo e restrições do seu projeto.</p><div class="hero-actions"><a class="button button-primary" href="https://calendly.com/wallisoncampanelli-eng/30min" target="_blank" rel="noopener noreferrer">Agendar conversa de 30 minutos</a><a class="button button-secondary" href="/pt/contato/">Falar sobre o seu projeto</a></div></div></section>
  </main>
</BaseLayout>
