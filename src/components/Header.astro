---
import { t, href, navKeys, routes, CALENDLY, type Lang, type PageKey } from "../i18n";

export interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const c = t(lang);
const links = navKeys.map((k) => ({ key: k, href: href(k, lang), label: c.nav[k] }));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={href("home", lang)} aria-label="Campanelli Analytics">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img src="/logo.png" alt="Campanelli Analytics" width="200" height="48" />
      </picture>
    </a>

    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">{c.ui.menu}</span>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={page === l.key ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <div class="lang-switch" role="group" aria-label={c.ui.langLabel}>
        <a href={routes[page].pt} hreflang="pt-BR" aria-current={lang === "pt" ? "true" : undefined}>PT</a>
        <a href={routes[page].en} hreflang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
      </div>
      <a class="btn btn--primary btn--sm" href={CALENDLY} target="_blank" rel="noopener">{c.nav.cta}</a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });
</script>
