---
// Form posts to FormSubmit (https://formsubmit.co), which forwards submissions to EMAIL.
// The FIRST submission triggers a one-time activation email to that inbox — click it once.
import { t, href, SITE, EMAIL, type Lang } from "../i18n";
export interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t(lang);
const f = c.contact.form;
---
<form class="contact-form" action={`https://formsubmit.co/${EMAIL}`} method="POST">
  <input type="hidden" name="_subject" value={f.subject} />
  <input type="hidden" name="_next" value={`${SITE}${href("thanks", lang)}`} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <input type="text" name="_honey" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="form-grid">
    <label>{f.name} *<input name="name" type="text" autocomplete="name" required /></label>
    <label>{f.email} *<input name="email" type="email" autocomplete="email" required /></label>
    <label>{f.phone}<input name="phone" type="tel" autocomplete="tel" /></label>
    <label>{f.organization}<input name="organization" type="text" autocomplete="organization" /></label>
    <label>{f.location}<input name="location" type="text" /></label>
    <label>{f.interest}
      <select name="topic">
        {f.interestOptions.map((o) => <option>{o}</option>)}
      </select>
    </label>
  </div>
  <label>{f.message} *<textarea name="message" required placeholder={f.messagePlaceholder}></textarea></label>
  <label class="consent"><input type="checkbox" name="consent" value="yes" required /> <span>{f.consent}</span></label>
  <button class="btn btn--primary btn--lg" type="submit">{f.submit}</button>
</form>
