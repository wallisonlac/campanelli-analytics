---
export interface Props {
  lang: "en" | "pt";
  contact: Record<string, any>;
}
const { lang, contact } = Astro.props;
const labels = contact.formLabels;
---
<!--
  This form uses a mailto: submission (no backend required).
  To switch to a hosted service, replace the <form action> below with your
  Formspree or Tally endpoint and remove the mailto script block.
-->
<form class="contact-form" id="contact-form" action={`mailto:${contact.email}`} method="POST" enctype="text/plain">
  <div class="form-row form-row--2">
    <div class="form-row">
      <label for="name">{labels.name} *</label>
      <input id="name" name="Name" type="text" required />
    </div>
    <div class="form-row">
      <label for="email">{labels.email} *</label>
      <input id="email" name="Email" type="email" required />
    </div>
  </div>
  <div class="form-row form-row--2">
    <div class="form-row">
      <label for="company">{labels.company}</label>
      <input id="company" name="Company" type="text" />
    </div>
    <div class="form-row">
      <label for="country">{labels.country}</label>
      <input id="country" name="Country" type="text" />
    </div>
  </div>
  <div class="form-row">
    <label for="interest">{labels.interest}</label>
    <select id="interest" name="Interest">
      {contact.interestOptions.map((opt: string) => <option value={opt}>{opt}</option>)}
    </select>
  </div>
  <div class="form-row">
    <label for="details">{labels.details} *</label>
    <textarea id="details" name="Project details" required></textarea>
  </div>
  <div class="form-row">
    <label for="timeline">{labels.timeline}</label>
    <input id="timeline" name="Estimated timeline" type="text" />
  </div>
  <div class="form-row form-row--checkbox">
    <input id="consent" name="Consent" type="checkbox" required />
    <label for="consent">{labels.consent}</label>
  </div>
  <button class="btn btn--primary" type="submit">{labels.submit}</button>
</form>
