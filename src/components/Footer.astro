---
import { t, href, navKeys, EMAIL, whatsappHref, WHATSAPP_DISPLAY, LINKEDIN, BOOKING, type Lang } from "../i18n";
export interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/logo.png" alt="Campanelli Analytics" width="200" height="48" loading="lazy" class="footer-logo" />
      <p>{c.footer.tagline}</p>
      <p class="footer-legal">
        {c.footer.company}<br />
        {c.footer.cnpj}<br />
        {c.footer.address}
      </p>
    </div>
    <nav aria-label={c.footer.navTitle}>
      <h2 class="footer-title">{c.footer.navTitle}</h2>
      <ul>
        {navKeys.map((k) => <li><a href={href(k, lang)}>{c.nav[k]}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2 class="footer-title">{c.footer.contactTitle}</h2>
      <ul>
        <li><a href={BOOKING} target="_blank" rel="noopener">{c.nav.cta}</a></li>
        <li><a href={whatsappHref(lang)} target="_blank" rel="noopener">WhatsApp {WHATSAPP_DISPLAY}</a></li>
        <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        <li><a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; {year} {c.footer.company}</span>
    <span>
      <a href={href("privacy", lang)}>{c.footer.privacy}</a> ·
      <a href={href("terms", lang)}>{c.footer.terms}</a>
    </span>
  </div>
</footer>
