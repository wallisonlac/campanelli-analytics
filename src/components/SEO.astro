---
import { SITE, routes, LINKEDIN, EMAIL, type Lang, type PageKey } from "../i18n/routes";

export interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  ogLocale: string;
  noindex?: boolean;
}
const { lang, page, title, description, ogLocale, noindex = false } = Astro.props;
const canonical = `${SITE}${routes[page][lang]}`;
const ptUrl = `${SITE}${routes[page].pt}`;
const enUrl = `${SITE}${routes[page].en}`;
const ogImage = `${SITE}/og-${lang}.png`;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE}/#organization`,
  name: "Campanelli Analytics",
  legalName: "Campanelli Analytics LTDA",
  taxID: "62.856.593/0001-40",
  url: SITE,
  logo: `${SITE}/logo.png`,
  image: `${SITE}/og-${lang}.png`,
  email: EMAIL,
  description,
  founder: { "@type": "Person", name: "Wallison Campanelli", sameAs: [LINKEDIN] },
  address: { "@type": "PostalAddress", addressLocality: "Muzambinho", addressRegion: "MG", addressCountry: "BR" },
  areaServed: ["BR", "PT", "EU", "GB", "CH"],
  knowsLanguage: ["pt-BR", "en", "es"],
  sameAs: [LINKEDIN],
  knowsAbout: ["Data engineering", "Process automation", "Business intelligence", "Power BI", "Microsoft Fabric", "Azure", "Public sector analytics"],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="alternate" hreflang="pt-BR" href={ptUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Campanelli Analytics" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Campanelli Analytics" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content="#0B1D3A" />

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

<!-- Analytics: add a Plausible or GA4 snippet here once an account/ID exists. -->
