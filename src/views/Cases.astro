---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CaseCard from "../components/CaseCard.astro";
import CTABand from "../components/CTABand.astro";
import { t, type Lang } from "../i18n";
export interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t(lang);
---
<BaseLayout lang={lang} page="cases">
  <PageHero eyebrow={c.cases.hero.eyebrow} title={c.cases.hero.title} subtitle={c.cases.hero.subtitle}>
    <ul class="trust__list trust__list--light">{c.home.hero.trust.map((s) => <li>{s}</li>)}</ul>
  </PageHero>
  <section class="section">
    <div class="container grid grid--cases">
      {c.cases.items.map((item) => <CaseCard lang={lang} item={item} />)}
    </div>
  </section>
  <CTABand lang={lang} title={c.cases.finalCta.title} text={c.cases.finalCta.text} />
</BaseLayout>
