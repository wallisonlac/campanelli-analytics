---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { t, CALENDLY, WHATSAPP, EMAIL, type Lang } from "../i18n";
export interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = t(lang);
const ch = c.contact.channels;
---
<BaseLayout lang={lang} page="contact">
  <PageHero eyebrow={c.contact.hero.eyebrow} title={c.contact.hero.title} subtitle={c.contact.hero.subtitle} />
  <section class="section">
    <div class="container contact-grid">
      <div class="channels">
        <a class="channel channel--primary" href={CALENDLY} target="_blank" rel="noopener">
          <h2>{ch.call.title}</h2><p>{ch.call.text}</p><span>calendly.com →</span>
        </a>
        <a class="channel" href={WHATSAPP} target="_blank" rel="noopener">
          <h2>{ch.whatsapp.title}</h2><p>{ch.whatsapp.text}</p><span>+351 935 678 698 →</span>
        </a>
        <a class="channel" href={`mailto:${EMAIL}`}>
          <h2>{ch.email.title}</h2><p>{ch.email.text}</p><span>{EMAIL}</span>
        </a>
      </div>
      <div class="form-card">
        <h2>{c.contact.form.title}</h2>
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>
